{
  "name": "anjali-amit-wedding-invitation",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run assets && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --exclude tests/content-lock.test.ts",
    "test:content": "vitest run tests/content-lock.test.ts",
    "test:e2e": "playwright test",
    "prepare:art": "node scripts/prepare-generated-art.mjs",
    "assets": "node scripts/build-assets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:content && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.6",
    "@fontsource/lora": "^5.2.6",
    "@fontsource/noto-serif-devanagari": "^5.2.6",
    "@fontsource/pinyon-script": "^5.2.6",
    "@fontsource/tiro-devanagari-sanskrit": "^5.3.0",
    "gsap": "^3.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
